NEXTAUTH_SECRET=your-secret-key-here
NEXT_PUBLIC_BASE_URL=http://localhost:5005
NEXTAUTH_URL=http://localhost:5005

AUTH_DB_PROVIDER=mongodb
AUTH_MODE=single

# MongoDB Atlas Database configuration
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/staff-management?retryWrites=true&w=majority"
MONGODB_DB="staff-management"
MONGODB_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/staff-management?retryWrites=true&w=majority"

# Mailer configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM=your-email@example.com
